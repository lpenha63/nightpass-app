# Copie para ".env" (mesma pasta) e preencha. NUNCA versione o .env com valores reais.

# URL pública onde a Evolution API vai responder (com https se tiver domínio/proxy).
# Ex.: http://SEU_IP:8080  ou  https://evolution.seudominio.com
SERVER_URL=http://SEU_IP:8080

# IMPORTANTE: use a MESMA chave que já está salva no NightPass (whatsapp_config.api_key,
# a de 8 caracteres) — assim o app continua funcionando sem trocar nada.
AUTHENTICATION_API_KEY=SUA_CHAVE_ATUAL_DE_8_CHARS

# Postgres (pode deixar esses valores; a senha use uma forte)
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque_esta_senha_forte
POSTGRES_DB=evolution
